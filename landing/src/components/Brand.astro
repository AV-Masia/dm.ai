---
// Set in type, not shipped as a logo file, so no trademark asset lives in this
// repository. An href makes it the header's link home; without one it is the
// footer's static mark.
interface Props {
  href?: string;
  label?: string;
}

const { href, label } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="brand" href={href} aria-label={label}>
  <span class="brand__epam">&lt;epam&gt;</span>
  <span class="brand__rule" aria-hidden="true"></span>
  <span class="brand__name">DMTools</span>
</Tag>
